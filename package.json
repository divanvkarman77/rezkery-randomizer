{
  "name": "rezka-suite",
  "private": true,
  "version": "2.0.0-alpha.1",
  "scripts": {
    "build": "node scripts/build-suite.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "lint": "eslint suite/*.js",
    "format": "prettier --write suite scripts tests/*.cjs eslint.config.cjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.4",
    "globals": "16.4.0",
    "linkedom": "0.18.12",
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
